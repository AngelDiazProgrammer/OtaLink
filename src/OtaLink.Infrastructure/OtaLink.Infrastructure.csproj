<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Servicios (una carpeta por módulo, cada uno implementa la interfaz de Application) y el registro
    de dependencias. Los servicios llaman a la base de datos solo a través de OtaLinkRutinas (Domain).
  -->
  <ItemGroup>
    <ProjectReference Include="..\OtaLink.Application\OtaLink.Application.csproj" />
    <ProjectReference Include="..\OtaLink.Domain\OtaLink.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>
</Project>
