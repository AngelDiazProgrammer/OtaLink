<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Servicios (una carpeta por módulo, cada uno implementa la interfaz de Application) y el registro
    de dependencias. Los servicios llaman a la base de datos solo a través de OtaLinkRutinas (Domain).
  -->
  <ItemGroup>
    <ProjectReference Include="..\OtaLink.Application\OtaLink.Application.csproj" />
    <ProjectReference Include="..\OtaLink.Domain\OtaLink.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      ASP.NET Core Identity (UserManager, SignInManager) y los tokens de portador viven en el marco
      compartido de ASP.NET Core, no en un paquete. Ese marco ya incluye la inyección de dependencias,
      la configuración, las opciones y el registro, así que no se referencian aparte.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
  </ItemGroup>
</Project>
