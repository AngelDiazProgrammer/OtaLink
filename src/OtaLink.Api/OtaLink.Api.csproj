<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- API REST con Minimal APIs. Es la raíz de composición: conoce todas las capas. -->
  <PropertyGroup>
    <!-- Identificador de User Secrets: guarda la cadena de conexión de desarrollo FUERA del repositorio. -->
    <UserSecretsId>otalink-api-dev</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OtaLink.Application\OtaLink.Application.csproj" />
    <ProjectReference Include="..\OtaLink.Contracts\OtaLink.Contracts.csproj" />
    <ProjectReference Include="..\OtaLink.Infrastructure\OtaLink.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <!-- Solo para que "dotnet ef" funcione; no viaja con la aplicación publicada. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
